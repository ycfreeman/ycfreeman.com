---
import { slug } from "github-slugger";
import Link from "@/components/Link";
import Tag from "@/components/Tag";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBlogs, getTagData } from "@/lib/content";

const tagData = getTagData(await getBlogs());
const sortedTags = Object.keys(tagData).sort((a, b) => tagData[b] - tagData[a]);
---

<BaseLayout pageTitle="Tags" socialDescription="Things I blog about">
  <div
    class="flex flex-col items-start justify-start divide-y divide-gray-200 md:mt-24 md:flex-row md:items-center md:justify-center md:space-x-6 md:divide-y-0 dark:divide-gray-700"
  >
    <div class="space-x-2 pt-6 pb-8 md:space-y-5">
      <h1
        class="text-3xl leading-9 font-extrabold tracking-tight text-gray-900 sm:text-4xl sm:leading-10 md:border-r-2 md:px-6 md:text-6xl md:leading-14 dark:text-gray-100"
      >
        Tags
      </h1>
    </div>
    <div class="flex max-w-lg flex-wrap">
      {!sortedTags.length && "No tags found."}
      {sortedTags.map((tag) => (
        <div class="mt-2 mr-5 mb-2">
          <Tag text={tag} />
          <Link
            href={`/tags/${slug(tag)}`}
            className="-ml-2 text-sm font-semibold text-gray-600 uppercase dark:text-gray-300"
            aria-label={`View posts tagged ${tag}`}
          >
            {` (${tagData[tag]})`}
          </Link>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
