---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ListLayout from "@/layouts/ListLayoutWithTags.astro";
import { getBlogs, getTagData, sortPosts } from "@/lib/content";

const POSTS_PER_PAGE = 5;

export async function getStaticPaths() {
  const postsPerPage = 5;
  const posts = await getBlogs();
  const totalPages = Math.ceil(posts.length / postsPerPage);
  return Array.from({ length: totalPages }, (_, index) => ({
    params: { page: String(index + 1) },
  }));
}

const allPosts = await getBlogs();
const posts = sortPosts(allPosts);
const page = Number(Astro.params.page);
const pagination = {
  currentPage: page,
  totalPages: Math.ceil(posts.length / POSTS_PER_PAGE),
};
const displayPosts = posts.slice(
  POSTS_PER_PAGE * (page - 1),
  POSTS_PER_PAGE * page,
);
---

<BaseLayout>
  <ListLayout
    posts={posts}
    initialDisplayPosts={displayPosts}
    pagination={pagination}
    title="All Posts"
    tagData={getTagData(allPosts)}
  />
</BaseLayout>
