---
import Image from "@/components/Image";
import SocialIcon from "@/components/social-icons";
import type { Author } from "@/lib/content";

interface Props {
  content: Author;
}

const { content } = Astro.props;
const { name, avatar, occupation, company, twitter, linkedin, github, paypal } =
  content;
---

<div class="divide-y divide-gray-200 dark:divide-gray-700">
  <div class="space-y-2 pt-6 pb-8 md:space-y-5">
    <h1
      class="text-3xl leading-9 font-extrabold tracking-tight text-gray-900 sm:text-4xl sm:leading-10 md:text-6xl md:leading-14 dark:text-gray-100"
    >
      About
    </h1>
  </div>
  <div
    class="items-start space-y-2 xl:grid xl:grid-cols-3 xl:space-y-0 xl:gap-x-8"
  >
    <div class="flex flex-col items-center space-x-2 pt-8">
      {avatar && (
        <Image
          src={avatar}
          alt="avatar"
          width={192}
          height={192}
          className="h-48 w-48 rounded-full"
        />
      )}
      <h3 class="pt-4 pb-2 text-2xl leading-8 font-bold tracking-tight">
        {name}
      </h3>
      <div class="text-gray-500 dark:text-gray-400">{occupation}</div>
      <div class="text-gray-500 dark:text-gray-400">{company}</div>
      <div class="flex space-x-3 pt-6">
        <SocialIcon kind="paypal" href={paypal} />
        <SocialIcon kind="github" href={github} />
        <SocialIcon kind="linkedin" href={linkedin} />
        <SocialIcon kind="twitter" href={twitter} />
      </div>
    </div>
    <div class="prose dark:prose-invert max-w-none pt-8 pb-8 xl:col-span-2">
      <slot />
    </div>
  </div>
</div>
