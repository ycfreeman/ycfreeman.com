{
  "name": "ycfreeman.com",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "astro dev",
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "serve": "astro preview",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "cf:build": "pnpm build",
    "cf:preview": "pnpm cf:build && wrangler dev",
    "cf:deploy": "pnpm cf:build && wrangler deploy",
    "cf:upload": "pnpm cf:build && wrangler versions upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@astrojs/mdx": "7.0.7",
    "@astrojs/react": "6.0.4",
    "@fancyapps/ui": "^6.1.14",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@giscus/react": "^3.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.2",
    "astro": "7.2.4",
    "github-slugger": "^2.0.0",
    "katex": "^0.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,css,md,mdx}": "oxfmt --write",
    "*.astro": "oxfmt --write"
  },
  "packageManager": "pnpm@11.7.0"
}
