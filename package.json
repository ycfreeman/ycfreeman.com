{
  "name": "ycfreeman.com",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "start": "astro dev",
    "dev": "test -d out/pagefind || pnpm build; astro dev",
    "check": "astro check",
    "build": "astro check && astro build && pagefind --site out",
    "serve": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "cf:deploy": "sst deploy --stage production"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/react": "7.1.0",
    "@fancyapps/ui": "^6.1.15",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@giscus/react": "^3.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "github-slugger": "^2.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-emoji": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "pagefind": "1.5.2",
    "sst": "4.17.2",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,css,md,mdx}": "oxfmt --write"
  },
  "packageManager": "pnpm@12.14.0"
}
